# Vynutit HTTPS a www (musí sedět s canonical adresou https://www.radimvrana.cz/)
RewriteEngine On

# Wedos hostuje víc domén pod /www/domains/<doména>/ a tahle reálná cesta na
# disku je dostupná i přímo jako URL (interní alias na hlavní doménu ji
# nezablokuje) — přesměruj ji na čistou adresu, ať existuje jen jeden odkaz.
RewriteCond %{THE_REQUEST} /domains/radimvrana\.cz/ [NC]
RewriteRule ^(.*)$ https://www.radimvrana.cz/$1 [R=301,L]

# Kanonická adresa vždy https://www.radimvrana.cz/<cesta> — cíl se skládá
# z THE_REQUEST (originální požadavek klienta), NE z HTTP_HOST/REQUEST_URI.
# Ty uvnitř tohoto /domains/<doména>/.htaccess kontextu odrážejí interní
# přepis provedený kořenovým /www/.htaccess (Wedos multi-doménový routing),
# takže by naivní "https://www.%{HTTP_HOST}%{REQUEST_URI}" zdvojilo "www."
# a prosáklo by do výsledné URL i interní segment "/domains/…" — ověřeno
# živě (http://www.radimvrana.cz/ mířilo na .../domains/radimvrana.cz/).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+(\S*) [NC]
RewriteRule ^ https://www.radimvrana.cz/%1 [R=301,L]

# Čisté adresy bez ".html" — kdo zadá/naklikne ".html" v URL, přesměruje se
# (301) na verzi bez přípony; interně se pak stránka dopočítá zpátky na
# skutečný soubor, takže na disku nic přejmenovávat nemusíme.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Základní bezpečnostní hlavičky
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Zabránit procházení obsahu adresářů
Options -Indexes
